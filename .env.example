# Configuración de extract-service (12-Factor: todo por variables de entorno).
# El servicio no lee este archivo solo; para desarrollo local:
#   cp .env.example .env
#   uv run --env-file .env python -m extractor

# Interfaz y puerto donde escucha uvicorn
HOST=0.0.0.0
PORT=8001

# Tamaño máximo del PDF recibido, en bytes (52428800 = 50MB)
MAX_UPLOAD_SIZE=52428800

# Threads dedicados a la extracción con PyMuPDF (CPU-bound): uno por núcleo asignado
THREAD_POOL_SIZE=1

# Backpressure. Mismos valores que el bloque de docker compose de más abajo:
# son los de producción y también los defaults de extractor/config.py.
# Tramo de extract del presupuesto de timeouts de punta a punta: hasta 15 s de
# espera (MAX_QUEUE_WAIT, que incluye los 5 s de UPLOAD_SLOT_TIMEOUT) + 8 s de
# deadline = 23 s. Cliente 30 s > documents 27 s > Traefik 25 s >= extract 23 s.
# Segundos que puede esperar un pedido antes de extraer; pasado eso, 503
MAX_QUEUE_WAIT=15
# Pedidos simultáneos por réplica (0 = sin límite)
MAX_CONCURRENT_UPLOADS=8
# Segundos que un pedido espera un cupo antes de recibir 503
UPLOAD_SLOT_TIMEOUT=5
# Segundos maximos de extraccion, chequeados entre paginas; pasado eso, 503.
# Sin esto un PDF pesado congela la replica: la extraccion no se puede cancelar.
EXTRACTION_DEADLINE=8
# Tope duro de paginas; por encima se responde 422 sin extraer (0 = sin limite)
MAX_PAGES=10000
# Readiness: si la extraccion en curso lleva mas de esto en el hilo,
# /health/ready responde 503 y Traefik saca la replica del balanceo.
# Tiene que ser MAYOR que EXTRACTION_DEADLINE (0 = siempre lista).
READINESS_STUCK_AFTER=12
# Apagado prolijo: segundos que se espera a los pedidos en curso al apagar.
# Mayor que MAX_QUEUE_WAIT + EXTRACTION_DEADLINE (23) y menor que el
# stop_grace_period de docker-compose.yml (30 s). En Compose queda el default.
SHUTDOWN_TIMEOUT=25

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# text | json. json emite un objeto por linea, para recolectores de logs.
# Cada linea lleva el request_id del pedido (header X-Request-ID).
LOG_FORMAT=text

# --- imagen (solo docker compose -f docker-compose.yml) ---
# Tag de ghcr.io/juandelosrios124/extract-service que corre el compose base.
# Vacio o latest en desarrollo; un sha-xxxxxxx o vX.Y.Z para una release o una
# medicion reproducible. Con el override (docker compose sin -f, o make up de
# infra) no se usa: ahi se compila local como extract-service:dev.
EXTRACT_IMAGE_TAG=

# --- docker compose ---
EXTRACT_REPLICAS=5
EXTRACT_CPUS=1.0
EXTRACT_MEMORY=1g
EXTRACT_MAX_UPLOAD_SIZE=52428800
EXTRACT_THREAD_POOL_SIZE=1
EXTRACT_LOG_LEVEL=INFO
EXTRACT_LOG_FORMAT=json
EXTRACT_MAX_QUEUE_WAIT=15
EXTRACT_MAX_CONCURRENT_UPLOADS=8
EXTRACT_UPLOAD_SLOT_TIMEOUT=5
EXTRACT_EXTRACTION_DEADLINE=8
EXTRACT_MAX_PAGES=10000
EXTRACT_READINESS_STUCK_AFTER=12

# --- COMPARTIDA: red Docker externa donde viven Consul, extract y documents ---
# Mismo nombre en los tres repos (infra, extract, documents): no renombrarla.
# Crearla una sola vez por maquina, antes del primer "docker compose up":
#   docker network create mired
SHARED_NETWORK=mired

# --- COMPARTIDA: service discovery con Consul (issue #16) ---
# Activa el autorregistro de cada replica. Encendido desde la #32: Traefik
# descubre las replicas por el catalogo. En false el servicio funciona igual,
# pero queda sin publicar en Traefik.
CONSUL_ENABLED=true
# URL del agente de Consul desde la red mired.
CONSUL_HTTP_ADDR=http://consul:8500
# Token de ACL: el valor de CONSUL_EXTRACT_TOKEN del .env de infra (no el de
# management). Nunca commitearlo:
# dejarlo vacio aca y completarlo solo en el .env local.
CONSUL_HTTP_TOKEN=

# --- Publicacion en Traefik mediante tags de Consul (issue #32) ---
# El circuit breaker, el retry y el limite de concurrencia los aplica Traefik,
# configurado con los tags que cada replica pone en su registro.
# Expresion del breaker. El rango [500, 503) deja afuera el 503 del
# backpressure: es la respuesta sana de una replica llena, no una falla.
TRAEFIK_CB_EXPRESSION=NetworkErrorRatio() > 0.30 || ResponseCodeRatio(500, 503, 0, 600) > 0.50
# Cuanto queda abierto el circuito, y cuanto dura la recuperacion gradual.
TRAEFIK_CB_FALLBACK=10s
TRAEFIK_CB_RECOVERY=10s
# Intentos del retry de Traefik. Solo reintenta ante un error de red antes de
# mandarle el pedido a la replica (p. ej. una replica caida), tambien en POST y
# con cualquier tamano de PDF. No reintenta respuestas (ni el 503 de la app) ni
# el 504 por responseHeaderTimeout (issue #55).
TRAEFIK_RETRY_ATTEMPTS=2
# Tope de pedidos simultaneos en el borde; Traefik responde 429 al pasarse.
# El doble de la capacidad agregada (5 replicas x 8 cupos).
TRAEFIK_INFLIGHT=80
# Header por el que Traefik agrupa ese tope (issue #55). Traefik pisa
# X-Forwarded-Server con su hostname en todos los pedidos: un unico tope para
# todos los clientes, que no se puede falsificar. Vacio = default de Traefik,
# un tope por cada Host (un cliente lo saltea cambiando el Host).
TRAEFIK_INFLIGHT_SOURCE_HEADER=X-Forwarded-Server
