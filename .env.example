# Configuración de extract-service (12-Factor: todo por variables de entorno).
# El servicio no lee este archivo solo; para desarrollo local:
#   cp .env.example .env
#   uv run --env-file .env python -m extractor

# Interfaz y puerto donde escucha uvicorn
HOST=0.0.0.0
PORT=8001

# Tamaño máximo del PDF recibido, en bytes (52428800 = 50MB)
MAX_UPLOAD_SIZE=52428800

# Threads dedicados a la extracción con PyMuPDF (CPU-bound): uno por núcleo asignado
THREAD_POOL_SIZE=1

# Backpressure. Mismos valores que el bloque de docker compose de más abajo:
# son los de producción y también los defaults de extractor/config.py.
# Segundos que puede esperar un pedido antes de extraer; pasado eso, 503
MAX_QUEUE_WAIT=20
# Pedidos simultáneos por réplica (0 = sin límite)
MAX_CONCURRENT_UPLOADS=8
# Segundos que un pedido espera un cupo antes de recibir 503
UPLOAD_SLOT_TIMEOUT=15

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# text | json. json emite un objeto por linea, para recolectores de logs.
# Cada linea lleva el request_id del pedido (header X-Request-ID).
LOG_FORMAT=text

# --- docker compose ---
EXTRACT_REPLICAS=5
EXTRACT_CPUS=1.0
EXTRACT_MEMORY=1g
EXTRACT_MAX_UPLOAD_SIZE=52428800
EXTRACT_THREAD_POOL_SIZE=1
EXTRACT_LOG_LEVEL=INFO
EXTRACT_LOG_FORMAT=json
PROXY_PORT=8001
PROXY_DIAL_TIMEOUT=5s
PROXY_TRY_DURATION=5s
PROXY_RESPONSE_TIMEOUT=60s
PROXY_READ_BODY_TIMEOUT=30s
PROXY_WRITE_TIMEOUT=2m
PROXY_IDLE_TIMEOUT=2m
EXTRACT_MAX_QUEUE_WAIT=20
EXTRACT_MAX_CONCURRENT_UPLOADS=8
EXTRACT_UPLOAD_SLOT_TIMEOUT=15

# --- COMPARTIDA: red Docker externa donde viven Consul, extract y documents ---
# Mismo nombre en los tres repos (infra, extract, documents): no renombrarla.
# Crearla una sola vez por maquina, antes del primer "docker compose up":
#   docker network create mired
SHARED_NETWORK=mired

# --- COMPARTIDA: service discovery con Consul (issue #16) ---
# Activa el autorregistro de cada replica. Encendido desde la #32: Traefik
# descubre las replicas por el catalogo. En false el servicio funciona igual,
# pero queda sin publicar en Traefik.
CONSUL_ENABLED=true
# URL del agente de Consul desde la red mired.
CONSUL_HTTP_ADDR=http://consul:8500
# Token de ACL (UUID, el mismo que el .env de infra). Nunca commitearlo:
# dejarlo vacio aca y completarlo solo en el .env local.
CONSUL_HTTP_TOKEN=

# --- Publicacion en Traefik mediante tags de Consul (issue #32) ---
# El circuit breaker, el retry y el limite de concurrencia los aplica Traefik,
# configurado con los tags que cada replica pone en su registro.
# Expresion del breaker. El rango [500, 503) deja afuera el 503 del
# backpressure: es la respuesta sana de una replica llena, no una falla.
TRAEFIK_CB_EXPRESSION=NetworkErrorRatio() > 0.30 || ResponseCodeRatio(500, 503, 0, 600) > 0.50
# Cuanto queda abierto el circuito, y cuanto dura la recuperacion gradual.
TRAEFIK_CB_FALLBACK=10s
TRAEFIK_CB_RECOVERY=10s
# Reintentos de Traefik ante error de red (no reintenta un 503 de la app).
TRAEFIK_RETRY_ATTEMPTS=2
# Tope de pedidos simultaneos en el borde; Traefik responde 429 al pasarse.
# El doble de la capacidad agregada (5 replicas x 8 cupos).
TRAEFIK_INFLIGHT=80
