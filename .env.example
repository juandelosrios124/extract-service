# Configuración de extract_service (12-Factor: todo por variables de entorno).
# El servicio no lee este archivo solo; para desarrollo local:
#   cp .env.example .env
#   uv run --env-file .env python -m extractor

# Interfaz y puerto donde escucha uvicorn
HOST=0.0.0.0
PORT=8001

# Tamaño máximo del PDF recibido, en bytes (52428800 = 50MB)
MAX_UPLOAD_SIZE=52428800

# Threads dedicados a la extracción con PyMuPDF (CPU-bound)
THREAD_POOL_SIZE=4

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- docker compose ---
EXTRACT_REPLICAS=5
EXTRACT_CPUS=1.0
EXTRACT_MEMORY=1g
EXTRACT_MAX_UPLOAD_SIZE=52428800
EXTRACT_THREAD_POOL_SIZE=4
EXTRACT_LOG_LEVEL=INFO
PROXY_PORT=8001
PROXY_DIAL_TIMEOUT=5s
PROXY_TRY_DURATION=5s
PROXY_RESPONSE_TIMEOUT=60s
PROXY_READ_BODY_TIMEOUT=30s
PROXY_WRITE_TIMEOUT=2m
PROXY_IDLE_TIMEOUT=2m

# --- docker compose ---
EXTRACT_REPLICAS=5
EXTRACT_CPUS=1.0
EXTRACT_MEMORY=1g
EXTRACT_MAX_UPLOAD_SIZE=52428800
EXTRACT_THREAD_POOL_SIZE=4
EXTRACT_LOG_LEVEL=INFO
PROXY_PORT=8001
PROXY_DIAL_TIMEOUT=5s
PROXY_TRY_DURATION=5s
PROXY_RESPONSE_TIMEOUT=60s
PROXY_READ_BODY_TIMEOUT=30s
PROXY_WRITE_TIMEOUT=2m
PROXY_IDLE_TIMEOUT=2m
